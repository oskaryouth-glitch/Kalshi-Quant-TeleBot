# Copy to .env.local for local development. Never commit real values.
# Every NEXT_PUBLIC_* value is embedded in client bundles at build time — never put secrets in them.

# Production URL, e.g. https://example.com. While unset, pages are noindex and robots.txt disallows all.
NEXT_PUBLIC_SITE_URL=

# Company facts shown on About, Contact, Privacy, Terms and the footer. Required before launch.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_ENTITY_JURISDICTION=
NEXT_PUBLIC_MAILING_ADDRESS=

# Contact addresses. Required before launch. Leave unset rather than using placeholders.
NEXT_PUBLIC_PARTNERS_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Waitlist storage (server-only secret). Without it, production reports sign-ups as not open.
DATABASE_URL=

# Tests only
TEST_DATABASE_URL=
E2E_DATABASE_URL=
